# Copy to .env and set real values. .env is gitignored: never commit it.
# Generate a key with: openssl rand -hex 24
API_KEY=

PORT=8080
REDIS_ADDR=localhost:6379
# If set, used instead of REDIS_ADDR and REDIS_PASSWORD (e.g. Render Key Value):
# redis://[user:password@]host:port[/db], or rediss:// for TLS
REDIS_URL=
REDIS_PASSWORD=
REDIS_TIMEOUT=200ms

# async: enqueue and answer 202; sync: write to Redis and answer 200
INGEST_MODE=async
QUEUE_SIZE=1024
WORKERS=4
BATCH_SIZE=100
FLUSH_INTERVAL=50ms

SHUTDOWN_TIMEOUT=10s
